# Generate EACH database password separately with: openssl rand -hex 32
# Hex avoids URL escaping issues. No application account is created automatically.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
APP_ORIGIN=http://localhost:8000
BIND_ADDRESS=127.0.0.1
# Keep true for HTTPS. Set false only for explicit local HTTP development.
SECURE_COOKIES=true
# Comma-separated exact HTTPS hostnames. Empty disables webhook registration/delivery.
WEBHOOK_HOSTS=
# For backend development outside Compose (URL-encode passwords):
# DATABASE_URL=postgresql+asyncpg://ted_owner:password@127.0.0.1:5432/ted
