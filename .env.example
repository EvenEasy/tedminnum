# Existing PostgreSQL database. Native execution does not use the Compose passwords below.
# URL-encode reserved characters in credentials. Never place DATABASE_URL in frontend env files.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@existing-postgres.example/ted

# Secure production defaults. APP_ORIGIN is the exact browser origin, with no trailing slash.
APP_ENV=production
APP_ORIGIN=https://ted.example.invalid
SECURE_COOKIES=true
DEV_ORIGINS=
SESSION_HOURS=12

# Native development: explicitly CHANGE the four values above to:
# APP_ENV=development
# APP_ORIGIN=http://localhost:8000
# SECURE_COOKIES=false
# DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vite proxies /api; no permissive CORS or Origin rewriting is needed.

# Optional outgoing webhooks: comma-separated exact HTTPS hosts; empty disables registration.
WEBHOOK_HOSTS=

# Optional Compose deployment only. Native execution requires none of these credentials/services.
# Generate EACH password separately with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
BIND_ADDRESS=127.0.0.1
